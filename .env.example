# 复制为 .env 并填入你的 Tushare 配置
# Tushare API 地址（默认官方 http://api.tushare.pro，需用私有代理时修改）
TUSHARE_API_URL=http://api.tushare.pro
# Tushare API Token（必填）
TUSHARE_TOKEN=your_tushare_token_here
CHANLUN_LOG_LEVEL=INFO

# Web 登录口令（公网部署必填，未配置服务将拒绝启动）。
# 如使用哈希：APP_PASSWORD_HASH=sha256(口令) 的十六进制小写，
# 此时请勿同时设置 APP_PASSWORD。
APP_PASSWORD=APP_PASSWORD
# APP_PASSWORD_HASH=

# 登录口令开关：true 开启登录守卫；false 关闭登录（仅本地/内网部署）
AUTH_ENABLED=true

# ===== 每日收盘分型监控 - 通知渠道配置 =====
# 通知渠道: feishu / wecom / none（none 仅打印不推送，用于本地调试）
NOTIFY_CHANNEL=none
# 飞书自定义机器人 webhook（开启签名校验时还需 FEISHU_SECRET）
FEISHU_WEBHOOK=
FEISHU_SECRET=
# 企业微信群机器人 webhook
WECOM_WEBHOOK=
# 监控触发时间（本地时区 HH:MM，建议收盘后 16:30）
NOTIFY_TIME=16:30
# 监控回看天数（取数区间长度，保证分型识别充分）
NOTIFY_LOOKBACK_DAYS=120
# 监控的股票代码列表（逗号分隔，支持纯数字或带后缀，统一自动标准化）
# 示例：600519,000858,300750,510300
MONITOR_CODES=600519,000858,300750,510300
