# 复制为 .env 并按需填入配置
CHANLUN_LOG_LEVEL=INFO

# Web 登录口令（公网部署必填，未配置服务将拒绝启动）。
# 留空则服务拒绝启动（fail-fast），请务必改成强口令后再部署。
# 如使用哈希：APP_PASSWORD_HASH=sha256(口令) 的十六进制小写，
# 此时请勿同时设置 APP_PASSWORD。
APP_PASSWORD=
# APP_PASSWORD_HASH=

# 登录口令开关：true 开启登录守卫；false 关闭登录（仅本地/内网部署）
AUTH_ENABLED=true

# ===== 每日收盘分型监控 - 通知渠道配置 =====
# 通知渠道: feishu / wecom / none（none 仅打印不推送，用于本地调试）
NOTIFY_CHANNEL=none
# 飞书自定义机器人 webhook（开启签名校验时还需 FEISHU_SECRET）
FEISHU_WEBHOOK=
FEISHU_SECRET=
# 企业微信群机器人 webhook
WECOM_WEBHOOK=
# 监控回看天数（取数区间长度，保证分型识别充分）
NOTIFY_LOOKBACK_DAYS=120
# 监控的股票代码列表（逗号分隔，支持纯数字或带后缀，统一自动标准化）
# 示例：600519,000858,300750,510300
MONITOR_CODES=600519,000858,300750,510300

# 内置定时调度（可选）：由程序自身周期性触发收盘监控
# MONITOR_SCHEDULE_ENABLED=true 开启；以下为触发时刻（机器本地时区）
MONITOR_SCHEDULE_ENABLED=false
MONITOR_SCHEDULE_HOUR=15
MONITOR_SCHEDULE_MINUTE=30
# 触发星期（APScheduler 表达式，mon-fri / * / sun 等），仅按 weekday 过滤，不感知节假日
# MONITOR_SCHEDULE_DAYS=mon-fri
# 法定节假日的"跳过"由 run_monitor 内 is_trading_day() 判断：优先查 cache/trade_dates.csv
# （依赖 stockdb.get_trade_days 增量拉取，含国庆/春节等法定假日）；
# 若 stockdb 不可达且本地缓存缺失，会回退到仅按 weekday 过滤，存在节假日误触发风险。
MONITOR_SCHEDULE_DAYS=mon-fri

# ===== 单标的 AI 深度分析（Web 悬浮按钮）=====
# AI_ENABLED=true 才会实际调用大模型；其余为空也可启动 Web（按钮仅给出配置指引）。
AI_ENABLED=false
# OpenAI 兼容端点（含 /v1）；本地 Ollama 可填 http://host.docker.internal:11434/v1
AI_BASE_URL=
# 模型名；本地 Ollama 可填 qwen2.5:7b 等
AI_MODEL=
# 凭据仅此处配置，绝不入库/不打印
AI_API_KEY=
# 可选调优项（不填则用默认值）
# 超时时间（秒）
AI_TIMEOUT=60
# 单次请求模型最大输出 token 数（控成本/防截断）
AI_MAX_TOKENS=4000
# 调用失败最大重试次数（0 或 1，避免重复烧 token）
AI_MAX_RETRY=1
# 以最新分型为起点的 K 线窗口根数（含分型本身及之后的 K 线与成交量，控 token/更精准）
AI_KLINE_WINDOW=30
